---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/subscribe.css';
import { wechat } from '../data/contacts';
const rssUrl = new URL('/rss.xml', Astro.site).href;
---
<BaseLayout title="订阅" description="通过 RSS 和微信公众号找到我。">
  <div class="container page-shell subscribe-page">
    <div class="contact-page-heading"><h1>你可以通过下面的方式找到我</h1></div>
    <div class="contacts-grid">
      <section class="contact-card" aria-labelledby="rss-title">
        <div class="contact-card-heading">
          <a class="contact-icon contact-icon-rss" href="/rss.xml" data-rss-file aria-label="打开 RSS 订阅文件" title="RSS 订阅"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 10a9 9 0 0 1 9 9M5 4a15 15 0 0 1 15 15"/><circle cx="6" cy="18" r="1.5" fill="currentColor" stroke="none"/></svg></a>
          <h2 id="rss-title">RSS订阅</h2>
        </div>
        <div class="rss-address-row"><input id="rss-address" type="text" readonly value={rssUrl} spellcheck="false" aria-label="RSS 订阅地址" /><button class="button rss-copy" type="button" data-copy-rss>复制地址</button></div>
      </section>
      <section class="contact-card" aria-labelledby="wechat-title">
        <div class="contact-card-heading">
          <span class="contact-icon contact-icon-wechat" aria-hidden="true"><svg viewBox="0 0 32 32" fill="currentColor" fill-rule="evenodd"><path d="M13 5C7.5 5 3 8.6 3 13c0 2.4 1.3 4.5 3.5 6L5.7 22l3.5-1.8c1.2.5 2.5.8 3.8.8h.5a8.9 8.9 0 0 1-.5-2.8c0-4.4 4.1-8 9.1-8h.4C21.1 7.2 17.4 5 13 5Zm-3.4 5.1a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Zm6.7 0a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z"/><path d="M22.1 11.6c-4.2 0-7.6 3-7.6 6.6s3.4 6.6 7.6 6.6c1.1 0 2.1-.2 3-.6l2.8 1.5-.7-2.6c1.6-1.2 2.5-2.9 2.5-4.9 0-3.6-3.4-6.6-7.6-6.6Zm-2.6 4a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm5.2 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg></span>
          <h2 id="wechat-title">微信公众号</h2>
        </div>
        <div class="wechat-content">
          <p class="wechat-name">{wechat.name}</p>
          {wechat.qrcode ? <img class="wechat-qrcode" src={wechat.qrcode} alt={wechat.name + '微信公众号二维码'} width="160" height="160" loading="lazy" /> :
            <div class="qr-placeholder" role="img" aria-label="公众号二维码占位，待补充">
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17V7h10m14 0h10v10M7 31v10h10m14 0h10V31"/></svg>
              <span>二维码待补充</span>
            </div>}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
