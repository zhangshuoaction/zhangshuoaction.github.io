---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_AUTHOR } from '../../consts';
import { getPublishedPosts, formatDate, postUrl, tagUrl, readingTime } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({ params: { slug: post.id }, props: { post, newer: posts[index - 1], older: posts[index + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const structuredData = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, datePublished: post.data.pubDate.toISOString(), dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(), author: { '@type': 'Person', name: SITE_AUTHOR }, mainEntityOfPage: new URL(postUrl(post), Astro.site).href };
---
<BaseLayout title={post.data.title} description={post.data.description} article pubDate={post.data.pubDate} updatedDate={post.data.updatedDate}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />
  <div class="container article-shell"><a class="back-link" href="/blog/">← 全部文章</a><header class="article-header"><div class="inline-tags">{post.data.tags.map((tag) => <a href={tagUrl(tag)}># {tag}</a>)}</div><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><div class="article-meta"><span class="author-avatar" aria-hidden="true">A</span><span>{SITE_AUTHOR}</span><span class="meta-dot">/</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span class="meta-dot">·</span><span>约 {readingTime(post.body)} 分钟</span>{post.data.updatedDate && <span>更新于 {formatDate(post.data.updatedDate)}</span>}</div></header><div class="article-layout"><div class="article-main">{post.data.sample && <aside class="sample-notice"><span aria-hidden="true">✳</span><div><strong>这是一篇示例文章</strong><p>用于展示博客的排版和内容结构，可直接替换为你的正式文章。</p></div></aside>}<article class="prose"><Content /></article><div class="article-end"><span>END OF NOTE</span><span aria-hidden="true">✳</span><p>感谢阅读，下一篇见。</p></div><nav class="post-pagination" aria-label="相邻文章">{newer ? <a href={postUrl(newer)}><span>← 较新一篇</span><strong>{newer.data.title}</strong></a> : <div></div>}{older ? <a href={postUrl(older)}><span>较早一篇 →</span><strong>{older.data.title}</strong></a> : <div></div>}</nav></div>{toc.length > 0 && <aside class="toc"><nav aria-label="文章目录"><span class="eyebrow">ON THIS PAGE</span><h2>文章目录</h2><ol>{toc.map(({ depth, slug, text }) => <li class:list={{ nested: depth === 3 }}><a href={'#' + slug}>{text}</a></li>)}</ol><a class="back-top" href="#main">回到顶部 ↑</a></nav></aside>}</div></div>
</BaseLayout>
