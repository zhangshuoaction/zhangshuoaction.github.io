---
import BlogArchive from '../../components/BlogArchive.astro';
import { getPublishedPosts, getTags } from '../../lib/posts';

export async function getStaticPaths() {
  return getTags(await getPublishedPosts()).map(({ name }) => ({ params: { tag: name }, props: { tag: name } }));
}
const { tag } = Astro.props;
---
<BlogArchive tag={tag} />
